# Copy to backend/.env for local runs. Do not put real secrets in git.
# The default provider is a deterministic mock, so the API runs with no keys.

LLM_PROVIDER=mock

# Used only when LLM_PROVIDER=openai
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Used only when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

# How many user/assistant turns to keep per session (a turn is one message).
MAX_HISTORY_TURNS=20

# Comma-separated browser origins, or * for local development.
CORS_ORIGINS=*
